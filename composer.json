{
    "name": "webdna/schedule-it",
    "description": "The site's scheduled jobs, kept in the repository: one cron entry runs them all.",
    "type": "craft-plugin",
    "version": "2.0.0",
    "keywords": ["craft", "cms", "cron", "schedule", "scheduler", "servd"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/webdna/schedule-it/issues?state=open",
        "source": "https://github.com/webdna/schedule-it",
        "docs": "https://github.com/webdna/schedule-it",
        "rss": "https://github.com/webdna/schedule-it/releases.atom"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0",
        "dragonmantank/cron-expression": "^3.0",
        "omnilight/yii2-scheduling": "^1.2",
        "symfony/process": "^5.0 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "webdna\\scheduleit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "webdna\\scheduleit\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "schedule-it",
        "name": "Schedule-it",
        "developer": "webdna",
        "documentationUrl": "https://github.com/webdna/schedule-it",
        "class": "webdna\\scheduleit\\ScheduleIt"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
